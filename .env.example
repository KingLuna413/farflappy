# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# App
NEXT_PUBLIC_APP_URL=https://farflappy.xyz

# WalletConnect / Reown (required by config/reownConfig.ts)
NEXT_PUBLIC_REOWN_PROJECT_ID=YOUR_REOWN_PROJECT_ID

# FarFlappy AI Arena — BNB Chain contracts (fill ONLY after a real deployment)
# Leave empty until then: the mint page will show a configuration message
# instead of sending any transaction.
NEXT_PUBLIC_FLAP_PILOT_ADDRESS=
NEXT_PUBLIC_FLAP_TOKEN_ADDRESS=
NEXT_PUBLIC_FLAP_ARENA_ADDRESS=

# Mint permit verifier (SERVER ONLY — no NEXT_PUBLIC_ prefix, NEVER commit).
# This key signs mintAgent permits in app/api/mint/permit/route.ts.
# It is NEVER logged and NEVER returned to the browser. If it is not set,
# /api/mint/permit returns 503 and no permit is issued. Rotate it with
# FlapPilot.setVerifier(newAddress) if it is ever exposed.
MINT_VERIFIER_PRIVATE_KEY=

# Agent ID claim verification (SERVER ONLY — no NEXT_PUBLIC_ prefix, NEVER commit).
# AGENT_ID_RESOLVER_URL: a deployer-configured resolver endpoint (with its
# own auth, e.g. a Binance service account) that resolves a ".ai" handle
# to a wallet address. Expected: POST { name, chainId } -> { address,
# isFallback, addressType } (or { data: {...} }). The permit route
# requires address === claiming wallet, isFallback !== true, and
# addressType === "EOA". If empty, claim verification FAILS CLOSED:
# /api/mint/permit returns 503 "resolver not configured" and no permit.
# Do NOT point this at the Binance bapi domain-resolve endpoint without
# a legitimate session/service account — that endpoint requires a
# Binance login and a user's private session must never be reused here.
# Do NOT invent a SpaceID registry address for this value.
AGENT_ID_RESOLVER_URL=

# TESTNET ONLY: comma-separated "0xWallet:handle.ai" pairs allowed to mint
# on BSC Testnet (97) before a production resolver exists. This proves
# NOTHING about a Binance claim. It is REJECTED for mainnet (56) by both
# lib/agentIdVerify.ts and app/api/mint/permit/route.ts, so it MUST be
# empty in any mainnet deployment. Example format (testnet only):
# AGENT_ID_TESTNET_ALLOWLIST=0xYourTestWalletAddress:yourhandle.ai
AGENT_ID_TESTNET_ALLOWLIST=

# Legacy tournament vault address (deprecated; FlapArena replaces it)
NEXT_PUBLIC_TOURNAMENT_VAULT_ADDRESS=

# Admin
ADMIN_SECRET=YOUR_ADMIN_SECRET

# Chain — BNB Chain mainnet (56). Use 97 (BSC Testnet) for testing only.
NEXT_PUBLIC_CHAIN_ID=56
