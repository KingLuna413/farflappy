# FarFlappy AI Arena — Hardhat deploy env (contracts/ only).
# Copy to contracts/.env and fill in. NEVER commit contracts/.env, and
# NEVER put any of these values in the repo, in chat, or in a NEXT_PUBLIC_ var.
#
# Deployer: a SEPARATE EOA used ONLY for deploying. This is NOT the Binance
# agent wallet (luna404.ai): that wallet is MPC, has no exportable private
# key, and baw has no contract-deploy command. For testnet, use a fresh
# testnet-only wallet funded with tBNB from a faucet. Never reuse a mainnet
# key for testnet, and never reuse the deployer key as a server verifier key.
DEPLOYER_PRIVATE_KEY=
#
# RPC endpoints (no API key values in the repo — put the full URL here only
# in your local, untracked contracts/.env):
BSC_TESTNET_RPC_URL=
BSC_RPC_URL=
#
# Verifier: the address whose signatures mintAgent() accepts AND that calls
# FlapArena.recordVerifiedScore(). Default (if unset) is the user's agent
# wallet address below — a PUBLIC address, not a secret. If you use that
# default, permits must be signed by that wallet (e.g. via `baw
# sign-message`), NOT by a server MINT_VERIFIER_PRIVATE_KEY, because the
# agent wallet key cannot be exported to a server. If you want automated
# server permits instead, set VERIFIER_ADDRESS to the server key's address
# and set MINT_VERIFIER_PRIVATE_KEY for that key in the Next.js server env.
VERIFIER_ADDRESS=
#
# FlapToken distribution addresses (constructor args). If unset, each
# defaults to the deployer — OK for a throwaway testnet deploy, FORBIDDEN
# for mainnet unless CONFIRM_MAINNET_DISTRIBUTION=yes is also set (see
# scripts/deploy.ts). For mainnet these MUST be multisig / vesting wallets.
FLAP_LIQUIDITY_ADDRESS=
FLAP_TEAM_ADDRESS=
FLAP_COMMUNITY_ADDRESS=
FLAP_TREASURY_ADDRESS=
#
# Mainnet guards (see scripts/deploy.ts). Both default to unset = deploy
# to BSC mainnet (56) is refused.
CONFIRM_MAINNET_DEPLOY=
CONFIRM_MAINNET_DISTRIBUTION=
#
# Optional: set to "skip" to deploy without moving the 40% reward share to
# the arena (you must then transfer it manually before rewards can be paid).
REWARD_FUNDING=
